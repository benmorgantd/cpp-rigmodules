        "type": "aimModule",
        "sockets": [["aim"], ["target"], ["up"]],
        "childPlugs": ["aim", "target", "up"]
      },
      "layout": {
        "type": "layoutModule",
        "sockets": [["index_0"], ["index_1"], ["index_2", "end"]],
