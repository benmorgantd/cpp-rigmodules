        "childPlugs": ["start"]
      },
      "fkchain_2": {
        "type": "fkChainModule",
        "sockets": [["index_0", "start", "end"]],
        "childPlugs": ["start"]
      },
      "layout": {
        "type": "layoutModule",
        "sockets": [["index_0"], ["index_1"], ["index_2", "end"]],
        "childPlugs": []
      }
    },
    "controls": {
