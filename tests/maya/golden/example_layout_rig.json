      },
      "fkchain3_ctrl_c": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "fkchain3"]
      },
      "fkchain4_ctrl_l": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ", "space"],
        "markup": ["Left", "fkchain4"],
        "spaces": ["FkChain", "Aim"]
      },
      "layout_0_ctrl_c": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "layout_0"]
      },
      "layout_1_ctrl_c": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "layout_1"]
      },
      "layout_2_ctrl_c": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
