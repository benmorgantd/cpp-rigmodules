{
  "description": "Public names of a single TwoBoneIk module: the six slots, its sockets and child plugs, and the channels D52 fixes",
  "template": "twoboneik_basic",
  "skeleton": "twoboneik_basic",
  "interface": {
    "modules": {
      "arm_01_L_MOD": {
        "type": "twoBoneIkModule",
        "sockets": [["index_0", "start"], ["index_1"], ["index_2", "end"], ["ik"], ["pole"], ["settings"]],
        "childPlugs": ["start", "ik", "pole", "settings"]
      },
      "layout_00_M_MOD": {
        "type": "layoutModule",
        "sockets": [["index_0"], ["index_1"], ["index_2", "end"]],
        "childPlugs": []
      }
    },
    "controls": {
      "armIK_00_L_CTRL": {
        "keyable": ["translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "roll"],
        "markup": ["Left", "armIK"]
      },
      "armPole_00_L_CTRL": {
        "keyable": ["translateX", "translateY", "translateZ", "pin", "space"],
        "markup": ["Left", "armPole"],
        "spaces": ["Parent", "Ik"]
      },
      "armSettings_00_L_CTRL": {
        "keyable": ["visibility", "ikFkBlend", "stretch", "soft"],
        "markup": ["Left", "armSettings"]
      },
      "hand_00_L_CTRL": {
        "keyable": ["translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Left", "hand"]
      },
      "layout_00_M_CTRL": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "layout_0"]
      },
      "layout_01_M_CTRL": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "layout_1"]
      },
      "layout_02_M_CTRL": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Center", "layout_2"]
      },
      "lowerArm_00_L_CTRL": {
        "keyable": ["translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Left", "lowerArm"]
      },
      "upperArm_00_L_CTRL": {
        "keyable": ["visibility", "translateX", "translateY", "translateZ", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"],
        "markup": ["Left", "upperArm"]
      }
    },
    "joints": ["hand_00_M_JNT", "lowerArm_00_M_JNT", "upperArm_00_M_JNT"],
    "constraints": {}
  }
}
