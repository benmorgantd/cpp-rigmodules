  "skeleton": "fk_three",
  "template": "fkchain_three",
  "set": { "a_00_M_CTRL.rotateZ": 90 },
  "expect": {
    "a_00_M_JNT": { "translate": [0, 0, 0], "rotate": [0, 0, 90] },
    "b_00_M_JNT": { "translate": [-2, 0, 0], "rotate": [0, 0, 90] },
    "c_00_M_JNT": { "translate": [-4, 0, 0], "rotate": [0, 0, 90] },
    "b_00_M_CTRL": { "translate": [-2, 0, 0] },
    "c_00_M_CTRL": { "translate": [-4, 0, 0] }
  }
}
